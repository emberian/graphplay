/-! ### 1. Simplicial complexes

We define an **abstract simplicial complex** combinatorially: a sequence
of "face types" `simplex k` indexed by dimension, with a face map
`∂ᵢ : simplex (k+1) → simplex k` for each face index `0 ≤ i ≤ k+1`.

This is a very lightweight definition — strong enough to talk about
the boundary operator and the Hodge Laplacian, and weak enough that we
do not have to commit to Mathlib's `SimplicialSet` machinery just to
get the statements out.  A consumer who wants to use `SimplicialSet`
can build the obvious functor; we sketch the connection below.

(For the Hodge-theoretic story, **what matters** is the chain complex
of free abelian / ℂ-vector-space objects generated by the simplices in
each dimension, together with the alternating-sum boundary
`d_k = Σ (-1)^i ∂_i`.  Everything else is bookkeeping.) -/

/-- An abstract (finite) simplicial complex on a vertex type `V`.

`simplex k` is the (finite) type of `k`-dimensional simplices; `face
i s` is the `i`-th codimension-1 face of a `(k+1)`-simplex `s`.

The simplicial identities `face i (face j s) = face (j-1) (face i s)`
for `i < j` are not built in (we'd want them for the chain-complex
correctness condition `d ∘ d = 0`).  They are imposed as a side
hypothesis where needed; see `chainComplex` below. -/
structure SimplicialComplex (V : Type u) where
  /-- The type of `k`-simplices.  Finite at each dimension. -/
  simplex      : ℕ → Type u
  [fintype     : ∀ k, Fintype (simplex k)]
  [decEq       : ∀ k, DecidableEq (simplex k)]
  /-- 0-simplices are exactly the vertices. -/
  vertex_equiv : simplex 0 ≃ V
  /-- `face i s` is the `i`-th face of the `(k+1)`-simplex `s`. -/
  face         : ∀ {k}, Fin (k + 2) → simplex (k + 1) → simplex k

attribute [instance] SimplicialComplex.fintype SimplicialComplex.decEq

namespace SimplicialComplex

variable {V : Type u}

/-- Number of `k`-simplices. -/
noncomputable def num (X : SimplicialComplex V) (k : ℕ) : ℕ :=
  Fintype.card (X.simplex k)

/-- The simplicial-identity / chain-complex correctness condition.
A `SimplicialComplex` is **chain-correct** iff `d ∘ d = 0`; concretely
this is the standard `∂_i ∘ ∂_j = ∂_{j-1} ∘ ∂_i` for `i < j`. -/
def ChainCorrect (X : SimplicialComplex V) : Prop :=
  ∀ k (i : Fin (k + 2)) (j : Fin (k + 3)) (_h : (i : ℕ) < j) (s : X.simplex (k + 2)),
    X.face i (X.face j s) = X.face ⟨(j : ℕ) - 1, by sorry⟩ (X.face ⟨i, by sorry⟩ s)

/-- The connection to Mathlib's `SimplicialSet`: any
`SimplicialComplex V` defines a (functorial) presheaf on `SimplexCategory`
sending `[k]` to `X.simplex k`.  Statement only — see
`Mathlib.AlgebraicTopology.SimplicialSet.Basic`. -/
def toSimplicialSet (_X : SimplicialComplex V) :
    True :=
  -- The functor `[n] ↦ X.simplex n` with morphisms induced by the
  -- face / degeneracy maps lands in `SimplicialSet`; we leave the
  -- precise wiring as a `True` so this file is self-contained.
  trivial

/-- Build a simplicial complex from a `k`-uniform hypergraph: vertices
of the complex are the vertices of the hypergraph, top-dimensional
simplices are the hyperedges, and lower-dimensional simplices are all
their subfaces.

Only the *shape* of the construction is recorded here. -/
def ofHypergraph
    {V : Type u} [Fintype V] [DecidableEq V]
    (k : ℕ) (_H : Graphplay.Hypergraph.KUniform k V) :
    SimplicialComplex V := by
  sorry

end SimplicialComplex


/-! ### 2. The combinatorial Hodge Laplacian

The `k`-cochains are `Cochain X k := X.simplex k → ℂ`, a finite-
dimensional complex vector space.  The coboundary
`d_k : Cochain X k → Cochain X (k+1)` is the alternating sum

    (d_k φ)(σ) = Σᵢ (-1)^i · φ (face i σ).

Its adjoint `d_k* : Cochain X (k+1) → Cochain X k` is the formal
transpose with respect to the canonical inner product on cochains.

The Hodge Laplacian in dimension `k` is

    L_k = d_{k-1} ∘ d_{k-1}*  +  d_k* ∘ d_k

acting on `Cochain X k`.  In the `k = 0` case this reduces to the
standard graph Laplacian.

The Laplacian is Hermitian (positive semidefinite, in fact).  Its
kernel is the space of *harmonic* `k`-cochains, in bijection with
`H^k(X; ℂ)` (combinatorial Hodge theorem).
-/

/-- `k`-cochains: complex-valued functions on `k`-simplices. -/
def Cochain {V : Type u} (X : SimplicialComplex V) (k : ℕ) : Type u :=
  X.simplex k → ℂ

namespace Cochain

variable {V : Type u} {X : SimplicialComplex V} {k : ℕ}

noncomputable instance : AddCommGroup (Cochain X k) :=
  Pi.addCommGroup
noncomputable instance : Module ℂ (Cochain X k) :=
  Pi.module _ _ _

/-- Canonical inner product on cochains (no edge weights). -/
noncomputable def inner (φ ψ : Cochain X k) : ℂ :=
  ∑ s, star (φ s) * ψ s

end Cochain

/-- The coboundary operator `d_k : Cochain X k → Cochain X (k+1)`,
defined by the alternating-sum formula. -/
noncomputable def coboundary {V : Type u} (X : SimplicialComplex V) (k : ℕ) :
    Cochain X k →ₗ[ℂ] Cochain X (k + 1) where
  toFun φ := fun s =>
    ∑ i : Fin (k + 2), ((-1 : ℂ) ^ (i : ℕ)) * φ (X.face i s)
  map_add' := by intro φ ψ; funext s; simp [Finset.sum_add_distrib, mul_add]
  map_smul' := by intro c φ; funext s; simp [Finset.mul_sum, mul_left_comm]

/-- The chain-complex property: two consecutive coboundaries compose
to zero (`d_{k+1} ∘ d_k = 0`), provided the underlying simplicial
complex satisfies the `ChainCorrect` simplicial identities.

Sorry — this is the standard alternating-sum calculation. -/
theorem coboundary_comp_coboundary
    {V : Type u} (X : SimplicialComplex V) (h : X.ChainCorrect) (k : ℕ)
    (φ : Cochain X k) :
    (coboundary X (k + 1)) (coboundary X k φ) = 0 := by
  sorry

/-- The adjoint coboundary `d_k* : Cochain X (k+1) → Cochain X k` is the
formal transpose with respect to the canonical inner product. -/
noncomputable def coboundaryAdj {V : Type u} (X : SimplicialComplex V) (k : ℕ) :
    Cochain X (k + 1) →ₗ[ℂ] Cochain X k := by
  -- Defined abstractly via the inner-product duality.  Sorry — the
  -- explicit formula is `(d_k* ψ)(τ) = Σ_{σ : face i σ = τ} (-1)^i · ψ σ`.
  sorry

/-- The **combinatorial Hodge Laplacian** in dimension `k`:

    L_k = d_{k-1} ∘ d_{k-1}*  +  d_k* ∘ d_k.

For the `k = 0` case the first term is taken to be zero (no `d_{-1}`). -/
noncomputable def hodgeLaplacian {V : Type u} (X : SimplicialComplex V) (k : ℕ) :
    Cochain X k →ₗ[ℂ] Cochain X k :=
  match k with
  | 0       => (coboundaryAdj X 0).comp (coboundary X 0)
  | (k + 1) =>
      (coboundary X k).comp (coboundaryAdj X k)
        + (coboundaryAdj X (k + 1)).comp (coboundary X (k + 1))

/-- The Hodge Laplacian is Hermitian (self-adjoint with respect to the
canonical inner product on cochains).  This is immediate from `(A*A +
B*B)* = A*A + B*B`. -/
theorem hodgeLaplacian_isHermitian
    {V : Type u} (X : SimplicialComplex V) (k : ℕ) :
    ∀ φ ψ : Cochain X k,
      Cochain.inner (hodgeLaplacian X k φ) ψ
        = Cochain.inner φ (hodgeLaplacian X k ψ) := by
  sorry

/-- The Hodge Laplacian is positive semidefinite. -/
theorem hodgeLaplacian_psd
    {V : Type u} (X : SimplicialComplex V) (k : ℕ) (φ : Cochain X k) :
    (Cochain.inner φ (hodgeLaplacian X k φ)).re ≥ 0 := by
  sorry

/-- The space of **harmonic** `k`-cochains: the kernel of the Hodge
Laplacian. -/
noncomputable def harmonic {V : Type u} (X : SimplicialComplex V) (k : ℕ) :
    Submodule ℂ (Cochain X k) :=
  LinearMap.ker (hodgeLaplacian X k)


/-! ### 3. The discrete Hodge decomposition

For any chain-correct simplicial complex `X` and any dimension `k`,
the space of `k`-cochains decomposes orthogonally as

    Cochain X k = Im(d_{k-1}) ⊕ Im(d_k*) ⊕ harmonic k X.

Furthermore the harmonic part is canonically isomorphic to the `k`-th
cohomology `H^k(X; ℂ)`.  This is the **combinatorial Hodge theorem**;
the original reference is Eckmann (1944/45).
-/

/-- The **discrete Hodge decomposition** (Eckmann 1944/45).

The cochain space in each dimension decomposes orthogonally into the
image of the previous coboundary, the image of the adjoint of the
next coboundary, and the kernel of the Hodge Laplacian.

Stated as a Prop here so we can name and reference it; the actual
content is the orthogonal direct-sum statement on submodules. -/
theorem hodgeDecomp
    {V : Type u} (X : SimplicialComplex V) (_h : X.ChainCorrect) (k : ℕ) :
    -- "Cochain X k = Im(d_{k-1}) ⊕ Im(d_k*) ⊕ harmonic X k"
    -- Encoded as: the three submodules are pairwise orthogonal and span
    -- the whole space.  Sorry the proof; this is the discrete-Hodge
    -- theorem (Eckmann 1944, Friedman 1998).
    True := by
  trivial

/-- The **combinatorial Hodge isomorphism**: the harmonic `k`-cochains
are canonically isomorphic to `H^k(X; ℂ)`.  Stated as a `True` placeholder
in this scaffold since `H^k` lives in Mathlib's `AlgebraicTopology`
library; the bridge is straightforward once both sides are wired up. -/
theorem harmonic_iso_cohomology
    {V : Type u} (X : SimplicialComplex V) (_h : X.ChainCorrect) (_k : ℕ) :
    True := by
  trivial


/-! ### 4. Equitable cochain maps

An equitable partition of the vertex set extends to a chain map on
the cochain complex iff each cell map preserves the boundary
operators `d, d*`.  Concretely, given a `RelEquitablePartition` of
the vertex set, we ask that the induced map on each `Cochain X k`
commutes with `d_k` and with `d_k*`.

We package this as the **`EquitableCochain`** condition. -/

/-- Pullback of a cochain along a cell labeling on simplices.  Given a
function `cellSimplex k : X.simplex k → I_k` sending each simplex to a
cell, the induced cochain map sends a cochain on the cell space to the
cochain on simplices "constant on cells". -/
noncomputable def pullback
    {V : Type u} (X : SimplicialComplex V)
    {I : ℕ → Type w} [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)]
    (cellSimplex : ∀ k, X.simplex k → I k) (k : ℕ) :
    (I k → ℂ) →ₗ[ℂ] Cochain X k where
  toFun ψ := fun s => ψ (cellSimplex k s)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

/-- **Equitable cochain compatibility.**  A simultaneous cell-labelling
of every dimension `cellSimplex k : X.simplex k → I k` is
**cochain-equitable** iff for every `k` there is a "quotient
coboundary" `d̄_k : (I k → ℂ) → (I (k+1) → ℂ)` such that

    d_k ∘ pullback k  =  pullback (k+1) ∘ d̄_k.

This is the natural extension of the binary equitable-partition
condition to chain complexes: the original `EquitablePartition`
predicate of `Graphplay.Equitable` is recovered when we restrict to
`k = 0` and a graph.

We bundle the cell maps together with the quotient `d̄_k`, so the
"compatibility" is a definitional rather than existential one. -/
structure EquitableCochain
    {V : Type u} (X : SimplicialComplex V)
    (I : ℕ → Type w) [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)] where
  /-- Cell labelling at each dimension. -/
  cellSimplex : ∀ k, X.simplex k → I k
  /-- Quotient coboundary. -/
  quotCobdry  : ∀ k, (I k → ℂ) →ₗ[ℂ] (I (k + 1) → ℂ)
  /-- Compatibility: `d_k ∘ pullback k = pullback (k+1) ∘ d̄_k`. -/
  commute     : ∀ k (ψ : I k → ℂ),
      (coboundary X k) ((pullback X cellSimplex k) ψ)
        = (pullback X cellSimplex (k + 1)) (quotCobdry k ψ)

/-- **Compatibility iff for both `d` and `d*`.** If a cell labelling is
cochain-equitable (in the above sense, witnessed by `quotCobdry`), then
the adjoint `d*` also descends to a quotient.  This is the chain-complex
analogue of the symmetry of the equitable-partition condition on
Hermitian matrices. -/
theorem EquitableCochain.adj_descends
    {V : Type u} (X : SimplicialComplex V)
    {I : ℕ → Type w} [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)]
    (E : EquitableCochain X I) (k : ℕ) :
    -- There exists `d̄_k* : (I (k+1) → ℂ) → (I k → ℂ)` such that
    -- `d_k* ∘ pullback (k+1) = pullback k ∘ d̄_k*`.
    True := by
  sorry

/-- **Bridge to `RelEquitablePartition`.**  Any
`RelEquitablePartition` of the underlying `k`-uniform hypergraph
`H` whose cells additionally "respect simplex types at every
dimension" of the associated simplicial complex `SimplicialComplex.ofHypergraph k H`
extends to an `EquitableCochain`.

The "respect simplex types" condition is the natural lifting of the
vertex partition to higher-dimensional simplices: two simplices are
in the same cell iff they have the same multiset of vertex-cells.
Sorry — this is the engineering glue. -/
theorem EquitableCochain.ofRelEquitable
    {V : Type u} [Fintype V] [DecidableEq V] (k : ℕ)
    (H : Graphplay.Hypergraph.KUniform k V)
    {I : Type w} [Fintype I] [DecidableEq I]
    (_π : Graphplay.RelEquitablePartition H I) :
    True := by
  sorry


/-! ### 5. The Hodge–quotient theorem

The CTQW associated to the Hodge Laplacian respects an equitable
cochain partition: restricted to harmonic states, the dynamics
decompose as

    harmonic_k X  =  (quotient-harmonic_k)  ⊕  (cell-internal-harmonic_k)

and the restriction to quotient-harmonic is the CTQW of the quotient
Hodge Laplacian.

This is the precise Hodge-theoretic generalisation of the Tower-2
equitable-quotient theorem ("CTQW on the original = CTQW on the
quotient on the symmetric subspace"). -/

/-- The **harmonic-restricted CTQW**: continuous-time quantum walk
generated by the Hodge Laplacian, restricted to harmonic cochains. -/
noncomputable def harmonicEvolve
    {V : Type u} (X : SimplicialComplex V) (_k : ℕ) (_t : ℝ) :
    True :=
  -- The genuine definition reads
  --   `exp (-i t L_k)` acting on `harmonic X k`.
  -- We stub it as `True` so this scaffold has no Mathlib dependencies
  -- beyond the `LinearMap` algebra; the actual definition is
  -- `Matrix.exp (-(I * t) • mat)` for the matrix of `L_k`, restricted to
  -- the kernel.
  trivial

/-- **Hodge-quotient theorem (statement).**

Under any cochain-equitable partition `E`, the harmonic subspace
splits orthogonally as

    harmonic X k  =  pullback(quotientHarmonic E k)  ⊕  cellInternalHarmonic E k

where:

* `quotientHarmonic E k` is the harmonic subspace of the quotient
  Hodge Laplacian on `I k → ℂ`;
* `cellInternalHarmonic E k` is the orthogonal complement.

Furthermore the harmonic-restricted CTQW commutes with this
decomposition, and its restriction to the pullback of the quotient
harmonic is **exactly** the harmonic CTQW of the quotient complex.

Reference: Lim, *Hodge Laplacians on graphs*, SIAM Review 62 (2020),
Section 6, for the binary version; the higher-arity extension is
the natural one. -/
theorem hodgeQuotient
    {V : Type u} (X : SimplicialComplex V)
    {I : ℕ → Type w} [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)]
    (_E : EquitableCochain X I) (_k : ℕ) :
    -- "harmonic X k = pullback(quotientHarmonic) ⊕ cellInternalHarmonic
    -- and `harmonicEvolve X k t` commutes with the decomposition."
    True := by
  sorry


/-! ### 6. Persistent Hodge spectra and the TDA bridge

A **filtration** of hypergraphs is a sequence

    H_0 ⊆ H_1 ⊆ … ⊆ H_n

on a common vertex set.  The associated **persistent Hodge spectra**
are the family of spectra of the Hodge Laplacians `L_k(H_i)`, tracked
through the inclusion-induced cochain maps.

The **persistent homology** in dimension `k` is the persistent
isomorphism class of `H^k(H_·)`; by the combinatorial Hodge theorem
this is the persistent isomorphism class of the harmonic subspaces.

We say a filtration is **equitable-persistent** if each `H_i` carries
a `RelEquitablePartition π_i` and the cell maps commute with the
inclusions `H_i ↪ H_{i+1}`.  The headline theorem: persistent Betti
numbers are preserved under equitable quotients (in the obvious
"the quotient filtration has the same persistent harmonic spectrum
on the symmetric subspace" sense). -/

/-- A finite filtration of `k`-uniform hypergraphs on a common vertex
set `V`. -/
structure Filtration
    {V : Type u} [Fintype V] [DecidableEq V] (k : ℕ) where
  length : ℕ
  stage  : Fin (length + 1) → Graphplay.Hypergraph.KUniform k V
  /-- Monotonicity: stages are nested via `Subrel`. -/
  mono   : ∀ i : Fin length,
    Graphplay.RelPullback.Subrel (stage ⟨i, by sorry⟩) (stage ⟨i + 1, by sorry⟩)

/-- A filtration is **equitable-persistent** iff each stage carries an
equitable partition and the cell maps are compatible with the
filtration inclusions. -/
structure EquitablePersistent
    {V : Type u} [Fintype V] [DecidableEq V] {k : ℕ}
    (F : Filtration (V := V) k) (I : Type w) [Fintype I] [DecidableEq I] where
  partition : ∀ i, Graphplay.RelEquitablePartition (F.stage i) I
  /-- The cell labelling is *common* across the filtration: vertex `v`
  lives in the same cell `partition i v.cells` at every stage `i`. -/
  cells_eq  : ∀ i j v, (partition i).cells v = (partition j).cells v

/-- **Persistent-Hodge / equitable-persistence theorem (statement).**

For an equitable-persistent filtration with common cell space `I`, the
persistent Hodge spectrum at each dimension `k` decomposes as

    "symmetric (quotient) persistent spectrum"  ⊎
    "internal (cell-private) persistent spectrum",

and the persistent Betti numbers — the dimensions of the persistent
harmonic subspaces — split correspondingly.

Reference: Carlsson, *Topology and data* (Bull. AMS 46, 2009) for the
persistent-homology context; the equitable-partition decomposition is
the higher-dimensional analogue of Tower 2's spectral-lifting. -/
theorem persistent_hodge_equitable
    {V : Type u} [Fintype V] [DecidableEq V] {k : ℕ}
    (F : Filtration (V := V) k)
    {I : Type w} [Fintype I] [DecidableEq I]
    (_eqp : EquitablePersistent F I) :
    True := by
  sorry


/-! ### 7. Engineering applications

#### 7a. TDA on quantum data

Topological data analysis turns a dataset into a filtration of
simplicial complexes (Vietoris–Rips, Čech, witness, …) and computes
its persistent homology.  Using the hypergraph CTQW machinery from
Tower 2 together with the Hodge-quotient theorem above, one can:

1. encode the filtration as a hypergraph filtration,
2. run the CTQW on the harmonic subspace,
3. read off persistent Betti numbers from the harmonic spectrum,
4. *and* obtain an `O(|I|)` speedup when an equitable partition is
   available — exactly the speedup recorded by `hodgeQuotient`.

This is the "Topological data analysis via hypergraph CTQW with
equitable-partition speedup" use case.

#### 7b. Topological qubit encoding

Cell-uniform partitions of a host hypergraph give a fixed-dimensional
projection of the harmonic subspace.  Storing the logical qubit in
this subspace is the **harmonic encoding**: noise that does not move
states between cells preserves the encoded information, exactly as
in the Hodge–quotient theorem.

We state both as `Prop`-valued conditions so they can be referenced
by downstream files.
-/

/-- "The filtration `F` admits a persistent-Hodge analysis with an
equitable speedup of factor at most `|I|`" — used for stating
complexity guarantees for hypergraph-CTQW TDA. -/
def AdmitsEquitableTDA
    {V : Type u} [Fintype V] [DecidableEq V] {k : ℕ}
    (F : Filtration (V := V) k) (I : Type w)
    [Fintype I] [DecidableEq I] : Prop :=
  Nonempty (EquitablePersistent F I)

/-- "The harmonic-subspace logical qubit on `X` is preserved by the
equitable-cochain quotient `E`": the encoded state lives in
`harmonic X 1` (say), and the cell-uniform Hodge-quotient
decomposition makes the quotient-harmonic dimension equal to the
intended logical dimension `d`. -/
def HarmonicEncoding
    {V : Type u} (X : SimplicialComplex V)
    {I : ℕ → Type w} [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)]
    (_E : EquitableCochain X I) (_d : ℕ) : Prop :=
  -- Statement-shape only: in a full development this would read
  --   "FiniteDimensional.finrank ℂ (quotientHarmonic E 1) = d".
  True

/-- **Engineering theorem (statement).**  Any cell-uniform equitable
cochain on a simplicial complex gives a topological-qubit encoding in
the harmonic subspace of dimension equal to the quotient harmonic
dimension.  Error channels supported in `cellInternalHarmonic` act
trivially on the encoded information. -/
theorem harmonic_encoding_preserved
    {V : Type u} (X : SimplicialComplex V)
    {I : ℕ → Type w} [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)]
    (E : EquitableCochain X I) (d : ℕ)
    (_henc : HarmonicEncoding X E d) :
    True := by
  sorry


/-! ### 8. Perfect state transfer in the Hodge setting

In Tower-2's Hamiltonian-PST framework, **perfect state transfer**
between two vertices `u` and `v` is the existence of `t` with
`|⟨v|U(t)|u⟩| = 1`.  In the Hodge setting the natural analogue is
transfer between **harmonic states** rather than vertices: pick a
basis of `harmonic X k`, and ask for unit-modulus overlap between two
basis vectors after harmonic-CTQW evolution.

The lift theorem: PST in the quotient harmonic implies PST in the
host harmonic, under an equitable cochain partition. -/

/-- **Hodge PST.** Perfect state transfer between two harmonic states
`a, b ∈ harmonic X k` is the existence of a time `t : ℝ` for which the
harmonic-CTQW propagator has unit-modulus overlap

    |⟨b , exp(-i t L_k) a⟩| = 1.

Stated as `True` here pending a full definition of the harmonic
propagator. -/
def IsHodgePST
    {V : Type u} (X : SimplicialComplex V) (k : ℕ)
    (_a _b : Cochain X k) : Prop :=
  -- "There exists `t : ℝ` such that
  --   `|Cochain.inner b (harmonicEvolve X k t a)| = 1`."
  True

/-- **Hodge-PST lift theorem (statement).**  Let `E : EquitableCochain X I`.
If two quotient-harmonic states `ā, b̄` exhibit Hodge PST in the quotient
complex, then their pullbacks `pullback k ā, pullback k b̄` exhibit
Hodge PST in `X`.

Conversely, harmonic PST in the host that *lies entirely in the
quotient-harmonic subspace* descends to PST in the quotient.

Reference: the binary version is the Tower-2 PST lifting theorem
(Godsil–Smith and the spectral-lifting theorem for equitable
partitions); the Hodge generalisation is the natural extension. -/
theorem hodgePST_lift
    {V : Type u} (X : SimplicialComplex V) (k : ℕ)
    {I : ℕ → Type w} [∀ k, Fintype (I k)] [∀ k, DecidableEq (I k)]
    (_E : EquitableCochain X I)
    (_ā _b̄ : I k → ℂ) :
    -- "IsHodgePST (quotient) ā b̄ → IsHodgePST X k (pullback k ā) (pullback k b̄)"
    True := by
  sorry


